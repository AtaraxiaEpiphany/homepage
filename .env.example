# shell-server (host process)
WS_PORT=8787
# Bind address. Loopback default; a non-loopback bind requires WS_TOKEN —
# the server refuses to start otherwise.
WS_HOST=127.0.0.1
# Shared secret sent as the first WS message ({"type":"auth"}). Empty = public
# mode, which is restricted to loopback binds only.
WS_TOKEN=
# Shared secret for the ops endpoints (/api/hosts, /api/metrics), sent as
# "Authorization: Bearer <token>". Empty falls back to WS_TOKEN; both empty
# (dev) leaves them open on the loopback-only server.
OPS_TOKEN=
MAX_SESSIONS=4
IDLE_TIMEOUT_MS=1800000
REATTACH_GRACE_MS=30000
# SIGTERM/SIGINT drain budget: new sessions refused, live ones get this long
# to finish before being killed.
DRAIN_TIMEOUT_MS=10000
# Abuse floor (per raw socket IP): create throttle, auth lockout, WS cap.
# RATE_LIMIT_DISABLED=1 lifts the floor (private deploys behind an auth proxy).
CREATE_RATE_PER_MIN=6
CREATE_RATE_BURST=6
AUTH_MAX_FAILURES=5
AUTH_LOCKOUT_MS=60000
MAX_WS_PER_IP=8
# Waiting room: sessions per browser (visitor token), queue depth, queue TTL.
# Raise VISITOR_MAX_SESSIONS high (e.g. 99) to effectively disable the budget.
VISITOR_MAX_SESSIONS=1
QUEUE_MAX=8
QUEUE_TIMEOUT_MS=120000
# Warm pool: pre-spawned shells handed out instantly on create. They count
# inside MAX_SESSIONS; POOL_SHELL_TTL_MS churns unclaimed ones.
POOL_SIZE=2
POOL_SHELL_TTL_MS=600000
# Saturation floors: grace/idle shrink toward these as the pool fills.
MIN_REATTACH_GRACE_MS=5000
MIN_IDLE_TIMEOUT_MS=180000
# Broker mode (multi-host): share the waiting room through redis. Empty =
# single-host memory store. Every host points at the same redis; capacity
# stays per-host, the queue is global — a saturated host's visitors spill
# to whoever drains next. Requires redis 6.2+ (GETDEL, LPOS).
BROKER_REDIS_URL=
# Unique id of this host in the broker presence registry (default: hostname-pid).
HOST_ID=
# WS base URL (wss://…) told to clients this host grants. Empty = same public
# origin — use when all hosts sit behind one reverse proxy.
HOST_PUBLIC_URL=
# CORS allowlist for /api (comma-separated origins). Empty reflects any
# origin — fine for local dev; public deployments should pin it, e.g.
# CORS_ORIGINS=https://yourname.github.io
CORS_ORIGINS=
CONTENT_DIR=./content
IMAGE=homepage-shell:latest

# web (build-time; Vite reads .env.local / CI variables)
VITE_BASE=/homepage/
VITE_WS_URL=
VITE_API_URL=
